    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <icon>PackageIcon.png</icon>
    <projectUrl>https://github.com/KornSW/UniversalBFF</projectUrl>
    <dependencies>
      <!-- (configuration for the Versioning-Util, which is not part of the xml-schema, because it's a pre-processor)
      "KVU": { 
        "versioningTwins":[ /* forced same [version] as our package and never treated as orphaned */
          "UniversalBFF.ModuleContract"
        ],
        "dependencySync": {
          "addMissing":true, "updateExisting":true, "allowDowngrades":true, "removeOrphaned":false,
          "constraintLevel":"SEM-SAFE",
          "blacklist": [
            "System.Data.SqlClient",
            "Newtonsoft.Json",
            /* PEER VON AUTHTOKENHANDLING */
            "jose-jwt", 
          ],
          "sources": [         
            { "origin":"src\\UniversalBFF.OobModules.UserManagement\\UniversalBFF.OobModules.UserManagement.csproj", "targetFramework":"*" }
          ]
        }
      } -->
      <group targetFramework="net10.0">
        <dependency id="UniversalBFF.ModuleContract" version="[1.0.1]" />
        <dependency id="SmartStandards.AuthTokenHandling" version="[5.1.1,6.0)" />
        <dependency id="ComponentDiscovery" version="[4.12.0,5.0)" />
        <dependency id="FUSE-fx.EfSupport" version="[3.0.1,4.0)" />
        <dependency id="FUSE-fx.EntityAnnotations" version="[4.3.0,5.0)" />
        <dependency id="FUSE-fx.ModelDescription" version="[2.1.0,3.0)" />
        <dependency id="FUSE-fx.RepositoryContract" version="[3.0.1,4.0)" />
        <dependency id="Microsoft.Data.SqlClient" version="[7.0.1,8.0)" />
        <dependency id="Microsoft.EntityFrameworkCore" version="[10.0.9,11.0)" />
        <dependency id="Microsoft.EntityFrameworkCore.Design" version="[10.0.9,11.0)" />
        <dependency id="Microsoft.EntityFrameworkCore.Proxies" version="[10.0.9,11.0)" />
        <dependency id="Microsoft.EntityFrameworkCore.SqlServer" version="[10.0.9,11.0)" />
        <dependency id="Microsoft.EntityFrameworkCore.Tools" version="[10.0.9,11.0)" />
        <dependency id="SmartAmbience" version="[2.5.1,3.0)" />
        <dependency id="SmartStandards.Logging" version="[3.4.4,4.0)" />
        <dependency id="Snowflake44" version="[3.8.3,4.0)" />
        <dependency id="UShell.PortfolioDescription" version="[4.1.2,5.0)" />
      </group>
    </dependencies>
  </metadata>
