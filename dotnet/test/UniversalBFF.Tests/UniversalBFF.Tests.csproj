<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UniversalBFF.Tests</AssemblyName>
    <RootNamespace>UniversalBFF</RootNamespace>
    <Deterministic>false</Deterministic>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ImportedNamespaces></ImportedNamespaces>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- META DATA -->

  <PropertyGroup>
    <PackageId>Tests</PackageId>
    <Description>UniversalBFF.Tests</Description>
    <Product>UniversalBFF.Tests</Product>
    <PackageTags></PackageTags>
    <Company></Company>
    <Copyright></Copyright>
    <Authors>Tests</Authors>
    <!-- VERSION -->
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1</AssemblyVersion>
    <FileVersion>1.1.1</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADDITIONAL ASSEMBLY-ATTRIBUTES -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SourceContext</_Parameter1>
      <_Parameter2>UniversalBFF.Tests</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- BUILD -->

  <PropertyGroup>
    <OutputPath>..\..\dist</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <DefineConstants>$(DefineConstants);NET_CORE;NET_8_;NET_10_;NET_10</DefineConstants>
    <NoWarn>$(NoWarn);1701;1702;1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);TRACE;DEBUG</DefineConstants>
    <Optimize>False</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <Optimize>True</Optimize>
  </PropertyGroup>

  <!-- REFERENCES -->

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.11.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ComponentDiscovery" Version="4.12.0" />
    <PackageReference Include="SmartStandards.AuthTokenHandling" Version="6.0.6" />
    <PackageReference Include="SmartStandards.Logging" Version="3.4.4" />
    <PackageReference Include="Snowflake44" Version="3.8.3" />
  </ItemGroup>

  <!-- INCLUDEs and FILEs -->

  <ItemGroup>
    <Compile Include="..\..\src\UniversalBFF.OobModules.UserManagement\Backend\BffUserService.OAuthCodeFlow.cs" Link="Production\BffUserService.OAuthCodeFlow.cs" />
    <Compile Include="..\..\src\UniversalBFF.OobModules.UserManagement\Backend\BffUserService.AmbientIdentity.cs" Link="Production\BffUserService.AmbientIdentity.cs" />
    <Compile Include="..\..\src\UniversalBFF.OobModules.UserManagement\Backend\BffUserService.Constants.cs" Link="Production\BffUserService.Constants.cs" />
  </ItemGroup>

</Project>