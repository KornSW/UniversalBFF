<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>UniversalBFF.ModuleContract</id>
    <version>1.1.0</version>
    <title>UniversalBFF.ModuleContract</title>
    <authors>KornSW and KeinIch</authors>
    <owners>(public domain)</owners>
    <copyright>KornSW and KeinIch</copyright>
    <description>API Contract for authors of application-modules that can be hosted within the UniversalBFF</description>
    <tags>BFF UShell SPA UJMW W3bstract</tags>
    <!-- https://spdx.org/licenses/ -->
    <license type="expression">GPL-3.0-only</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <icon>PackageIcon.png</icon>
    <projectUrl>https://github.com/KornSW/UniversalBFF</projectUrl>
    <dependencies>
      <!-- (configuration for the Versioning-Util, which is not part of the xml-schema, because it's a pre-processor)
      "KVU": { 
        "versioningTwins":[ /* forced same [version] as our package and never treated as orphaned */
        ],
        "dependencySync": {
          "addMissing":true, "updateExisting":true, "allowDowngrades":true, "removeOrphaned":false,
          "constraintLevel":"SEM-SAFE",
          "blacklist": [
            "System.Data.SqlClient",
            "Newtonsoft.Json",
            /* PEER VON AUTHTOKENHANDLING */
            "jose-jwt", 
          ],
          "sources": [         
            { "origin":"src\\UniversalBFF.ModuleContract.net8.0\\UniversalBFF.ModuleContract.net8.0.csproj", "targetFramework":"=" },
            { "origin":"src\\UniversalBFF.ModuleContract.net10.0\\UniversalBFF.ModuleContract.net10.0.csproj", "targetFramework":"=" }
          ]
        }
      } -->
      <group targetFramework="net8.0">
        <dependency id="Newtonsoft.Json" version="[13.0.3,13.9999]" />
        <dependency id="SmartStandards.AuthTokenHandling" version="[5.1.1,6.0)" />
        <dependency id="UShell.PortfolioDescription" version="[4.1.3,5.0)" />
        <dependency id="UShell.ServerCommands.Contract" version="[1.2.1,2.0)" />
      </group>
       <group targetFramework="net10.0">
        <dependency id="Newtonsoft.Json" version="[13.0.4,13.9999]" />
        <dependency id="SmartStandards.AuthTokenHandling" version="[5.1.1,6.0)" />
        <dependency id="UShell.PortfolioDescription" version="[4.1.3,5.0)" />
        <dependency id="UShell.PortfolioHosting.Mvc" version="[4.1.3,5.0)" />
        <dependency id="UShell.ServerCommands.Contract" version="[1.2.1,2.0)" />
      </group>     
    </dependencies>
  </metadata>
  <files>
    <!-- https://docs.microsoft.com/en-us/nuget/create-packages/creating-a-package#from-a-convention-based-working-directory -->
    <file src="PackageIcon.png" target="" /> 
    <!-- .NET 8.0 -->
    <file src="dist\net8.0\UniversalBFF.ModuleContract.dll" target="lib/net8.0" />
    <file src="dist\net8.0\UniversalBFF.ModuleContract.xml" target="lib/net8.0" />
    <file src="dist\net8.0\UniversalBFF.ModuleContract.pdb" target="lib/net8.0" />
    <!-- .NET 10.0 -->
    <file src="dist\net10.0\UniversalBFF.ModuleContract.dll" target="lib/net10.0" />
    <file src="dist\net10.0\UniversalBFF.ModuleContract.xml" target="lib/net10.0" />
    <file src="dist\net10.0\UniversalBFF.ModuleContract.pdb" target="lib/net10.0" />
  </files>
</package>
