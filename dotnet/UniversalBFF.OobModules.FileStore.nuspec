<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>UniversalBFF.OobModules.FileStore</id>
    <version>1.0.0</version>
    <title>UniversalBFF.OobModules.FileStore</title>
    <authors>KornSW and KeinIch</authors>
    <owners>(public domain)</owners>
    <copyright>KornSW and KeinIch</copyright>
    <description>FileStore (OOB Module)</description>
    <tags>BFF UShell SPA UJMW W3bstract</tags>
    <!-- https://spdx.org/licenses/ -->
    <license type="expression">GPL-3.0-only</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <icon>PackageIcon.png</icon>
    <projectUrl>https://github.com/KornSW/UniversalBFF</projectUrl>
    <dependencies>
      <!-- (configuration for the Versioning-Util, which is not part of the xml-schema, because it's a pre-processor)
      "KVU": { 
        "versioningTwins":[ /* forced same [version] as our package and never treated as orphaned */
          "UniversalBFF.ModuleContract"
        ],
        "dependencySync": {
          "addMissing":true, "updateExisting":true, "allowDowngrades":true, "removeOrphaned":false,
          "constraintLevel":"SEM-SAFE",
          "blacklist": [
            "System.Data.SqlClient",
            "Newtonsoft.Json",
            /* PEER VON AUTHTOKENHANDLING */
            "jose-jwt", 
          ],
          "sources": [         
            { "origin":"src\\UniversalBFF.OobModules.FileStore\\UniversalBFF.OobModules.FileStore.csproj", "targetFramework":"*" }
          ]
        }
      } -->
      <group targetFramework="net10.0">
        <dependency id="UniversalBFF.ModuleContract" version="[1.0.0]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <!-- https://docs.microsoft.com/en-us/nuget/create-packages/creating-a-package#from-a-convention-based-working-directory -->
    <file src="PackageIcon.png" target="" />
    <!-- .NET 10.0 -->
    <file src="dist\net10.0\UniversalBFF.OobModules.FileStore.dll" target="lib/net10.0" />
    <file src="dist\net10.0\UniversalBFF.OobModules.FileStore.xml" target="lib/net10.0" />
    <file src="dist\net10.0\UniversalBFF.OobModules.FileStore.pdb" target="lib/net10.0" />
  </files>
</package>
